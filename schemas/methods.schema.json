{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schemas:methods:1",
  "title": "Atlas open-vocabulary method candidate artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "status",
    "corpus",
    "extraction",
    "coverage",
    "curated_families",
    "assets",
    "notice"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator_version": { "const": "methods-1" },
    "status": { "const": "corpus-extracted-candidates" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "source_count", "month_count"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_count": { "$ref": "#/$defs/count" },
        "month_count": { "$ref": "#/$defs/count" }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_version",
        "minimum_support",
        "maximum_evidence",
        "candidate_limit"
      ],
      "properties": {
        "normalization_version": { "const": "method-phrase-1" },
        "minimum_support": { "type": "integer", "minimum": 1 },
        "maximum_evidence": { "const": 6 },
        "candidate_limit": { "type": "null" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned_papers",
        "scanned_abstracts",
        "quarantined_abstracts",
        "extracted_mentions",
        "distinct_extracted_candidates",
        "qualified_candidates"
      ],
      "properties": {
        "scanned_papers": { "$ref": "#/$defs/count" },
        "scanned_abstracts": { "$ref": "#/$defs/count" },
        "quarantined_abstracts": { "$ref": "#/$defs/count" },
        "extracted_mentions": { "$ref": "#/$defs/count" },
        "distinct_extracted_candidates": { "$ref": "#/$defs/count" },
        "qualified_candidates": { "$ref": "#/$defs/count" }
      }
    },
    "curated_families": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/family" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "notice": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "label", "paper_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "const": "curated-family" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "paper_count": { "$ref": "#/$defs/count" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "sha256", "row_count"],
      "properties": {
        "path": { "const": "candidates.jsonl.gz" },
        "encoding": { "const": "jsonl+gzip" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "$ref": "#/$defs/count" }
      }
    },
    "scope_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likely", "possible", "outside"],
      "properties": {
        "likely": { "$ref": "#/$defs/count" },
        "possible": { "$ref": "#/$defs/count" },
        "outside": { "$ref": "#/$defs/count" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "field",
        "span",
        "text",
        "published",
        "primary_category"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^arxiv:(?:[0-9]{4}\\.[0-9]{4,5}|[a-z]+(?:[.-][a-z]+)*/[0-9]{7})$"
        },
        "field": { "const": "abstract" },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 160 },
        "published": { "type": "string", "minLength": 10, "maxLength": 64 },
        "primary_category": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "label",
        "kind",
        "head",
        "support_count",
        "mention_count",
        "first_year",
        "last_year",
        "scope_counts",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^method-candidate:[0-9a-f]{64}$" },
        "status": { "const": "corpus-extracted-candidate" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["method-noun", "process-technique"] },
        "head": { "type": "string", "minLength": 1, "maxLength": 32 },
        "support_count": { "type": "integer", "minimum": 1 },
        "mention_count": { "type": "integer", "minimum": 1 },
        "first_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "last_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "scope_counts": { "$ref": "#/$defs/scope_counts" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
