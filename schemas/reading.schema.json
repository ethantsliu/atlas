{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/reading.schema.json",
  "title": "Structured full-paper reading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stable_id",
    "reading_depth",
    "source_provenance",
    "question",
    "key_findings",
    "method",
    "techniques",
    "evaluations",
    "limitations",
    "failure_modes",
    "reusable_insights",
    "open_questions",
    "competitive_landscape",
    "novelty_assessment",
    "confidence",
    "reviewer_notes"
  ],
  "properties": {
    "stable_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "reading_depth": { "enum": ["full_text", "verified"] },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_locator",
        "text_sha256",
        "page_count",
        "extracted_at",
        "review_pass"
      ],
      "properties": {
        "source_locator": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "pdf_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_format": { "const": "html" },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "page_count": { "type": "integer", "minimum": 1 },
        "extracted_at": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "review_pass": {
          "enum": ["primary-full-text-v1", "secondary-verified-v1"]
        }
      },
      "oneOf": [
        {
          "required": ["pdf_sha256"],
          "not": {
            "anyOf": [
              { "required": ["source_format"] },
              { "required": ["source_sha256"] }
            ]
          }
        },
        {
          "required": ["source_format", "source_sha256"],
          "not": { "required": ["pdf_sha256"] }
        }
      ]
    },
    "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "key_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence", "anchors"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "attribution": {
            "enum": [
              "author-reported",
              "reviewer-inference",
              "contradiction-audit"
            ]
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "section"],
              "properties": {
                "page": { "type": "integer", "minimum": 1 },
                "section": { "type": "string", "minLength": 1, "pattern": "\\S" }
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_idea", "mechanism", "assumptions"],
      "properties": {
        "core_idea": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "mechanism": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "role": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setting", "metric", "result", "baseline"],
        "properties": {
          "setting": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "metric": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "result": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "baseline": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "limitations": { "$ref": "#/$defs/nonemptyStrings" },
    "failure_modes": { "$ref": "#/$defs/nonemptyStrings" },
    "reusable_insights": { "$ref": "#/$defs/nonemptyStrings" },
    "open_questions": { "$ref": "#/$defs/nonemptyStrings" },
    "competitive_landscape": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "title", "url", "relationship", "difference"],
        "properties": {
          "canonical_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "url": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "relationship": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "difference": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "source_kind": {
            "enum": [
              "arxiv",
              "openreview",
              "official-proceedings",
              "publisher"
            ]
          },
          "checked_at": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "source_version": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "novelty_assessment": {
      "oneOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "$ref": "#/$defs/structuredNovelty" }
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reviewer_notes": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "checked_at",
        "passage_check",
        "competitor_check"
      ],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "pattern": "^reviewer-[0-9a-f]{12}$"
        },
        "checked_at": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "passage_check": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "competitor_check": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reading_depth": { "const": "full_text" } },
        "required": ["reading_depth"]
      },
      "then": {
        "properties": {
          "source_provenance": {
            "properties": {
              "review_pass": { "const": "primary-full-text-v1" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "reading_depth": { "const": "verified" } },
        "required": ["reading_depth"]
      },
      "then": {
        "required": ["verification"],
        "properties": {
          "novelty_assessment": { "$ref": "#/$defs/structuredNovelty" },
          "source_provenance": {
            "properties": {
              "review_pass": { "const": "secondary-verified-v1" }
            }
          },
          "key_findings": {
            "items": { "required": ["attribution"] }
          },
          "competitive_landscape": {
            "items": {
              "required": ["source_kind", "checked_at", "source_version"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "structuredNovelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_claim", "reviewer_inference"],
      "properties": {
        "author_claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": { "type": "string" },
        "reviewer_inference": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
