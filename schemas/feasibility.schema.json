{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/feasibility.schema.json",
  "title": "Auditable feasibility score",
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "band", "factors", "assumptions", "version"],
  "properties": {
    "score": { "type": "number", "minimum": 1, "maximum": 10 },
    "band": { "enum": ["low", "medium", "high"] },
    "screening_estimate": { "type": "boolean" },
    "factors": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "max", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "score": { "type": "number", "minimum": 0 },
          "max": { "type": "number", "exclusiveMinimum": 0 },
          "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
