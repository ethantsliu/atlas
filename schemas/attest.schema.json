{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schemas:attest:1",
  "title": "Atlas declared-human triage attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reviewer_mode",
    "reviewer_id",
    "checked_at",
    "decision",
    "packet_digest",
    "candidate_digest",
    "corpus_digest",
    "retrieval_digest",
    "support_digest",
    "checklist",
    "notice",
    "attestation_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "declared-human-attestation" },
    "reviewer_mode": { "const": "declared-human" },
    "reviewer_id": {
      "type": "string",
      "pattern": "^reviewer:[0-9a-f]{64}$"
    },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decision": {
      "enum": ["accept-provisional", "hold", "reject"]
    },
    "packet_digest": { "$ref": "#/$defs/sha256" },
    "candidate_digest": { "$ref": "#/$defs/sha256" },
    "corpus_digest": { "$ref": "#/$defs/sha256" },
    "retrieval_digest": { "$ref": "#/$defs/sha256" },
    "support_digest": { "$ref": "#/$defs/sha256" },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_mechanism_relevance",
        "identity_distinctness",
        "experimental_testability",
        "retrieval_inspected",
        "no_novelty_claim"
      ],
      "properties": {
        "support_mechanism_relevance": { "$ref": "#/$defs/verdict" },
        "identity_distinctness": { "$ref": "#/$defs/verdict" },
        "experimental_testability": { "$ref": "#/$defs/verdict" },
        "retrieval_inspected": { "$ref": "#/$defs/verdict" },
        "no_novelty_claim": { "$ref": "#/$defs/verdict" }
      }
    },
    "notice": {
      "const": "Declared human review only; not authenticated proof, publication, or a novelty claim."
    },
    "attestation_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdict": { "enum": ["pass", "hold", "reject"] }
  }
}
