{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schemas:methodbundle:1",
  "title": "Atlas durable browser method package receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "status",
    "tier",
    "corpus",
    "browser",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator_version": { "const": "methods-browser-1" },
    "status": { "const": "validated-browser-package" },
    "tier": { "enum": ["full-evidence", "catalog-only"] },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "source_count", "month_count"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_count": { "$ref": "#/$defs/count" },
        "month_count": { "$ref": "#/$defs/count" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "sha256",
        "bytes",
        "file_count",
        "unpacked_bytes",
        "index_sha256"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^browser-[0-9a-f]{64}\\.tar\\.gz$" },
        "encoding": { "const": "tar+gzip" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positive" },
        "file_count": { "type": "integer", "minimum": 2, "maximum": 100000 },
        "unpacked_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "index_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "sha256", "bytes", "row_count"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^candidates(?:-[0-9a-f]{64})?\\.jsonl\\.gz$"
        },
        "encoding": { "const": "jsonl+gzip" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positive" },
        "row_count": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
