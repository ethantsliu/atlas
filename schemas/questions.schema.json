{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schemas:questions:1",
  "title": "Atlas corpus-derived unreviewed research-question candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "status",
    "source_catalog",
    "policy",
    "counts",
    "candidates",
    "notice",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator_version": { "const": "questions-1" },
    "status": { "const": "corpus-derived-unreviewed-candidates" },
    "source_catalog": { "$ref": "#/$defs/source_catalog" },
    "policy": { "$ref": "#/$defs/policy" },
    "counts": { "$ref": "#/$defs/counts" },
    "candidates": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "notice": { "type": "string", "minLength": 1 },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive_count": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "generator_version",
        "corpus_manifest_sha256",
        "source_papers",
        "source_directions"
      ],
      "properties": {
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "generator_version": { "const": "catalog-2" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_papers": { "$ref": "#/$defs/count" },
        "source_directions": { "$ref": "#/$defs/count" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "identity_version",
        "template_version",
        "candidate_per_direction",
        "review_status",
        "novelty_status",
        "feasibility_status",
        "evidence_relation"
      ],
      "properties": {
        "digest": { "$ref": "#/$defs/sha256" },
        "identity_version": { "const": "direction-question-1" },
        "template_version": { "const": "comparative-conditions-1" },
        "candidate_per_direction": { "const": 1 },
        "review_status": { "const": "unreviewed" },
        "novelty_status": { "const": "not-assessed" },
        "feasibility_status": { "const": "not-assessed" },
        "evidence_relation": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_directions",
        "unreviewed_candidate_questions",
        "reviewed_ideas_added"
      ],
      "properties": {
        "source_directions": { "$ref": "#/$defs/count" },
        "unreviewed_candidate_questions": { "$ref": "#/$defs/count" },
        "reviewed_ideas_added": { "const": 0 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "technique_id"],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9.-]{1,31}$"
        },
        "technique_id": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "source_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "support_count",
        "year_count",
        "independent_author_groups_at_least",
        "npmi"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^direction:[0-9a-f]{64}$" },
        "support_count": { "$ref": "#/$defs/positive_count" },
        "year_count": { "$ref": "#/$defs/positive_count" },
        "independent_author_groups_at_least": {
          "$ref": "#/$defs/positive_count"
        },
        "npmi": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "month", "path", "sha256", "row"],
      "properties": {
        "id": { "type": "string", "pattern": "^arxiv:\\S+$" },
        "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "path": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9a-f]{16})?\\.json\\.gz$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "row": { "$ref": "#/$defs/count" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_kind",
        "status",
        "review_status",
        "novelty_status",
        "feasibility_status",
        "rank",
        "identity",
        "question",
        "source_direction",
        "support_ids",
        "support_refs",
        "evidence_relation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^question:[0-9a-f]{64}$" },
        "candidate_kind": { "const": "research-question" },
        "status": { "const": "corpus-derived-unreviewed-candidate" },
        "review_status": { "const": "unreviewed" },
        "novelty_status": { "const": "not-assessed" },
        "feasibility_status": { "const": "not-assessed" },
        "rank": { "$ref": "#/$defs/positive_count" },
        "identity": { "$ref": "#/$defs/identity" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source_direction": { "$ref": "#/$defs/source_direction" },
        "support_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^arxiv:\\S+$" }
        },
        "support_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/support" }
        },
        "evidence_relation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
