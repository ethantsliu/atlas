{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:schemas:methodpack:1",
  "title": "Atlas browser method candidate assets",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/top" },
    { "$ref": "#/$defs/search_manifest" },
    { "$ref": "#/$defs/detail_manifest" },
    { "$ref": "#/$defs/router" },
    { "$ref": "#/$defs/search_leaf" },
    { "$ref": "#/$defs/detail_leaf" },
    { "$ref": "#/$defs/catalog_top" },
    { "$ref": "#/$defs/catalog_search_manifest" },
    { "$ref": "#/$defs/catalog_detail_manifest" },
    { "$ref": "#/$defs/catalog_router" },
    { "$ref": "#/$defs/catalog_search_leaf" },
    { "$ref": "#/$defs/catalog_detail_leaf" }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "source_count", "month_count"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_count": { "$ref": "#/$defs/count" },
        "month_count": { "$ref": "#/$defs/count" }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_version",
        "minimum_support",
        "maximum_evidence",
        "candidate_limit"
      ],
      "properties": {
        "normalization_version": { "const": "method-phrase-1" },
        "minimum_support": { "$ref": "#/$defs/positive" },
        "maximum_evidence": { "const": 6 },
        "candidate_limit": { "type": "null" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned_papers",
        "scanned_abstracts",
        "quarantined_abstracts",
        "extracted_mentions",
        "distinct_extracted_candidates",
        "qualified_candidates"
      ],
      "properties": {
        "scanned_papers": { "$ref": "#/$defs/count" },
        "scanned_abstracts": { "$ref": "#/$defs/count" },
        "quarantined_abstracts": { "$ref": "#/$defs/count" },
        "extracted_mentions": { "$ref": "#/$defs/count" },
        "distinct_extracted_candidates": { "$ref": "#/$defs/count" },
        "qualified_candidates": { "$ref": "#/$defs/count" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "label", "paper_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "const": "curated-family" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "paper_count": { "$ref": "#/$defs/count" }
      }
    },
    "families": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/family" }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "encoding", "sha256", "bytes", "row_count"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:summary|top|search|details|search-route|detail-route|search-[a-z0-9]{3,12}|detail-[0-9a-f]{2,8})-[0-9a-f]{16}\\.json$"
        },
        "encoding": { "const": "json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positive" },
        "row_count": { "$ref": "#/$defs/count" }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "encoding", "sha256", "bytes", "row_count"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[A-Za-z0-9][A-Za-z0-9._-]{0,99}/candidates(?:-[0-9a-f]{64})?\\.jsonl\\.gz$"
        },
        "encoding": { "const": "jsonl+gzip" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positive" },
        "row_count": { "$ref": "#/$defs/count" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prefix",
        "path",
        "encoding",
        "sha256",
        "bytes",
        "row_count"
      ],
      "properties": {
        "kind": { "enum": ["leaf", "router"] },
        "route_mode": { "enum": ["word", "hash", "ordinal"] },
        "prefix": { "type": "string", "pattern": "^[a-z0-9]{0,12}$" },
        "hash_prefix": { "type": "string", "pattern": "^[0-9a-f]{0,8}$" },
        "start_ordinal": { "$ref": "#/$defs/count" },
        "end_ordinal": { "$ref": "#/$defs/count" },
        "path": {
          "type": "string",
          "pattern": "^(?:search-route|detail-route|search-[a-z0-9]{3,12}|detail-[0-9a-f]{2,8})-[0-9a-f]{16}\\.json$"
        },
        "encoding": { "const": "json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positive" },
        "row_count": { "$ref": "#/$defs/positive" }
      }
    },
    "scope_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likely", "possible", "outside"],
      "properties": {
        "likely": { "$ref": "#/$defs/count" },
        "possible": { "$ref": "#/$defs/count" },
        "outside": { "$ref": "#/$defs/count" }
      }
    },
    "compact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "label",
        "kind",
        "head",
        "support_count",
        "mention_count",
        "first_year",
        "last_year",
        "scope_counts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^method-candidate:[0-9a-f]{64}$" },
        "status": { "const": "corpus-extracted-candidate" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["method-noun", "process-technique"] },
        "head": { "type": "string", "minLength": 1, "maxLength": 32 },
        "support_count": { "$ref": "#/$defs/positive" },
        "mention_count": { "$ref": "#/$defs/positive" },
        "first_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "last_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "scope_counts": { "$ref": "#/$defs/scope_counts" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "full_row_sha256", "id", "status", "label", "kind",
        "head", "support_count", "mention_count", "first_year", "last_year",
        "scope_counts"
      ],
      "properties": {
        "ordinal": { "$ref": "#/$defs/count" },
        "full_row_sha256": { "$ref": "#/$defs/sha256" },
        "id": { "type": "string", "pattern": "^method-candidate:[0-9a-f]{64}$" },
        "status": { "const": "corpus-extracted-candidate" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["method-noun", "process-technique"] },
        "head": { "type": "string", "minLength": 1, "maxLength": 32 },
        "support_count": { "$ref": "#/$defs/positive" },
        "mention_count": { "$ref": "#/$defs/positive" },
        "first_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "last_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "scope_counts": { "$ref": "#/$defs/scope_counts" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "field",
        "span",
        "text",
        "published",
        "primary_category"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^arxiv:(?:[0-9]{4}\\.[0-9]{4,5}|[a-z]+(?:[.-][a-z]+)*/[0-9]{7})$"
        },
        "field": { "const": "abstract" },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 160 },
        "published": { "type": "string", "minLength": 10, "maxLength": 64 },
        "primary_category": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "label",
        "kind",
        "head",
        "support_count",
        "mention_count",
        "first_year",
        "last_year",
        "scope_counts",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^method-candidate:[0-9a-f]{64}$" },
        "status": { "const": "corpus-extracted-candidate" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["method-noun", "process-technique"] },
        "head": { "type": "string", "minLength": 1, "maxLength": 32 },
        "support_count": { "$ref": "#/$defs/positive" },
        "mention_count": { "$ref": "#/$defs/positive" },
        "first_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "last_year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "scope_counts": { "$ref": "#/$defs/scope_counts" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generator_version",
        "status",
        "tier",
        "corpus",
        "extraction",
        "coverage",
        "curated_families",
        "assets",
        "notice"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "generator_version": { "const": "methods-browser-1" },
        "status": { "const": "corpus-extracted-candidates" },
        "tier": { "enum": ["full-evidence", "catalog-only"] },
        "corpus": { "$ref": "#/$defs/corpus" },
        "extraction": { "$ref": "#/$defs/extraction" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "curated_families": { "$ref": "#/$defs/families" },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "top", "search", "details", "download"],
          "properties": {
            "summary": { "$ref": "#/$defs/asset" },
            "top": { "$ref": "#/$defs/asset" },
            "search": { "$ref": "#/$defs/asset" },
            "details": { "$ref": "#/$defs/asset" },
            "download": { "$ref": "#/$defs/download" }
          }
        },
        "notice": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_manifest_sha256",
        "qualified_candidates",
        "distinct_extracted_candidates",
        "curated_families",
        "by_kind",
        "by_scope",
        "by_support",
        "by_first_year"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "qualified_candidates": { "$ref": "#/$defs/count" },
        "distinct_extracted_candidates": { "$ref": "#/$defs/count" },
        "curated_families": { "$ref": "#/$defs/families" },
        "by_kind": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": { "enum": ["method-noun", "process-technique"] },
              "count": { "$ref": "#/$defs/count" }
            }
          }
        },
        "by_scope": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "count"],
            "properties": {
              "scope": { "enum": ["likely", "possible", "outside"] },
              "count": { "$ref": "#/$defs/count" }
            }
          }
        },
        "by_support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum", "count"],
            "properties": {
              "minimum": { "$ref": "#/$defs/positive" },
              "maximum": {
                "oneOf": [{ "$ref": "#/$defs/positive" }, { "type": "null" }]
              },
              "count": { "$ref": "#/$defs/count" }
            }
          }
        },
        "by_first_year": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "count"],
            "properties": {
              "year": { "type": "string", "pattern": "^[0-9]{4}$" },
              "count": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    },
    "top": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus_manifest_sha256", "order", "rows"],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "order": { "const": "support-desc-label-asc-head-asc" },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/compact" }
        }
      }
    },
    "search_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_manifest_sha256",
        "normalization",
        "minimum_query_length",
        "row_count",
        "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "normalization": { "const": "nfkc-lower-alnum-space-1" },
        "minimum_query_length": { "const": 3 },
        "row_count": { "$ref": "#/$defs/count" },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "detail_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_manifest_sha256",
        "prefix_bits",
        "row_count",
        "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "prefix_bits": { "const": 8 },
        "row_count": { "$ref": "#/$defs/count" },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_manifest_sha256",
        "route_kind",
        "route_mode",
        "prefix",
        "row_count",
        "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "route_kind": { "enum": ["search", "detail"] },
        "route_mode": { "enum": ["word", "hash"] },
        "prefix": { "type": "string", "pattern": "^[a-z0-9]{0,12}$" },
        "hash_prefix": { "type": "string", "pattern": "^[0-9a-f]{0,8}$" },
        "row_count": { "$ref": "#/$defs/positive" },
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        }
      }
    },
    "search_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "corpus_manifest_sha256",
        "prefix",
        "hash_prefix",
        "rows"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "prefix": { "type": "string", "pattern": "^[a-z0-9]{3,12}$" },
        "hash_prefix": { "type": "string", "pattern": "^[0-9a-f]{0,8}$" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compact" }
        }
      }
    },
    "detail_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus_manifest_sha256", "prefix", "rows"],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "prefix": { "type": "string", "pattern": "^[0-9a-f]{2,8}$" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    },
    "catalog_top": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus_manifest_sha256", "full_asset_sha256", "order", "rows"],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "order": { "const": "support-desc-label-asc-head-asc" },
        "rows": {
          "type": "array", "maxItems": 200,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "catalog_search_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "corpus_manifest_sha256", "full_asset_sha256",
        "normalization", "minimum_query_length", "row_count", "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "normalization": { "const": "nfkc-lower-alnum-space-1" },
        "minimum_query_length": { "const": 3 },
        "row_count": { "$ref": "#/$defs/count" },
        "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "catalog_detail_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "corpus_manifest_sha256", "full_asset_sha256",
        "route_kind", "route_mode", "start_ordinal", "end_ordinal",
        "row_count", "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "route_kind": { "const": "detail" },
        "route_mode": { "const": "ordinal" },
        "start_ordinal": { "$ref": "#/$defs/count" },
        "end_ordinal": { "$ref": "#/$defs/count" },
        "row_count": { "$ref": "#/$defs/count" },
        "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "catalog_router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "corpus_manifest_sha256", "full_asset_sha256",
        "route_kind", "route_mode", "prefix", "row_count", "shards"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "route_kind": { "enum": ["search", "detail"] },
        "route_mode": { "enum": ["word", "hash", "ordinal"] },
        "prefix": { "type": "string", "pattern": "^[a-z0-9]{0,12}$" },
        "hash_prefix": { "type": "string", "pattern": "^[0-9a-f]{1,8}$" },
        "start_ordinal": { "$ref": "#/$defs/count" },
        "end_ordinal": { "$ref": "#/$defs/count" },
        "row_count": { "$ref": "#/$defs/positive" },
        "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
      }
    },
    "catalog_search_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "corpus_manifest_sha256", "full_asset_sha256",
        "prefix", "hash_prefix", "ordinals"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "prefix": { "type": "string", "pattern": "^[a-z0-9]{3,12}$" },
        "hash_prefix": { "type": "string", "pattern": "^[0-9a-f]{0,8}$" },
        "ordinals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/count" }
        }
      }
    },
    "catalog_detail_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "corpus_manifest_sha256", "full_asset_sha256",
        "route_kind", "route_mode", "prefix", "start_ordinal", "end_ordinal", "columns", "rows"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_asset_sha256": { "$ref": "#/$defs/sha256" },
        "route_kind": { "const": "detail" },
        "route_mode": { "const": "ordinal" },
        "prefix": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
        "start_ordinal": { "$ref": "#/$defs/count" },
        "end_ordinal": { "$ref": "#/$defs/count" },
        "columns": {
          "const": [
            "ordinal", "full_row_sha256", "id", "status", "label", "kind",
            "head", "support_count", "mention_count", "first_year", "last_year",
            "scope_counts"
          ]
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "prefixItems": [
              { "$ref": "#/$defs/count" },
              { "$ref": "#/$defs/sha256" },
              { "type": "string", "pattern": "^method-candidate:[0-9a-f]{64}$" },
