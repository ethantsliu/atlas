{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethantsliu.github.io/atlas/schemas/packet.schema.json",
  "title": "Atlas full-corpus idea triage packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_kind",
    "status",
    "candidate",
    "lineage",
    "support_papers",
    "retrieval_candidates",
    "checklist",
    "review_gate",
    "packet_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_kind": { "const": "full-corpus-idea-triage" },
    "status": { "const": "unreviewed" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_digest", "identity"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^idea:[0-9a-f]{64}$"
        },
        "candidate_digest": { "$ref": "#/$defs/sha256" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "intervention", "mechanism", "outcome"],
          "properties": {
            "target": { "type": "string", "minLength": 1, "maxLength": 160 },
            "intervention": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "mechanism": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "outcome": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_digest",
        "candidate_digest",
        "retrieval_digest",
        "support_digest"
      ],
      "properties": {
        "corpus_digest": { "$ref": "#/$defs/sha256" },
        "candidate_digest": { "$ref": "#/$defs/sha256" },
        "retrieval_digest": { "$ref": "#/$defs/sha256" },
        "support_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "support_papers": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/supportPaper" }
    },
    "retrieval_candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/retrievalCandidate" }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_mechanism_relevance",
        "identity_distinctness",
        "experimental_testability",
        "retrieval_inspected",
        "no_novelty_claim"
      ],
      "properties": {
        "support_mechanism_relevance": { "$ref": "#/$defs/pending" },
        "identity_distinctness": { "$ref": "#/$defs/pending" },
        "experimental_testability": { "$ref": "#/$defs/pending" },
        "retrieval_inspected": { "$ref": "#/$defs/pending" },
        "no_novelty_claim": { "$ref": "#/$defs/pending" }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_promotion", "required_receipt"],
      "properties": {
        "automatic_promotion": { "const": false },
        "required_receipt": { "const": "separate-declared-human-receipt" }
      }
    },
    "packet_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pending": { "const": "pending-human-review" },
    "arxivId": {
      "type": "string",
      "pattern": "^arxiv:(?:[0-9]{4}\\.[0-9]{4,5}|[a-z][a-z0-9.-]*/[0-9]{7})$"
    },
    "archiveReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "path", "sha256", "row"],
      "properties": {
        "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "path": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}\\.json\\.gz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "row": { "type": "integer", "minimum": 0 }
      }
    },
    "supportPaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "title", "url", "published", "archive"],
      "properties": {
        "canonical_id": { "$ref": "#/$defs/arxivId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "url": { "type": "string", "pattern": "^https://arxiv\\.org/abs/" },
        "published": { "type": "string", "minLength": 10 },
        "archive": { "$ref": "#/$defs/archiveReference" }
      }
    },
    "retrievalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "score", "shared_terms", "status"],
      "properties": {
        "canonical_id": { "$ref": "#/$defs/arxivId" },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "shared_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "const": "candidate_only" }
      }
    }
  }
}
